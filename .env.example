# --- Option A (default): OpenRouter — one key, any model. https://openrouter.ai/keys
# Either name is accepted.
OPEN_ROUTER_KEY=
# OPENROUTER_API_KEY=

# --- Option B: use a provider key directly (no OpenRouter account needed).
# Set exactly one of these and the matching provider is auto-selected.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Force a provider explicitly if more than one key is present:
# MODEL_PROVIDER=anthropic        # openrouter | anthropic | openai | google

# Model used by all agents (must support tool calling). Defaults per provider:
#   openrouter -> anthropic/claude-haiku-4.5   anthropic -> claude-haiku-4-5
#   openai     -> gpt-4o-mini                  google    -> gemini-2.5-flash
# MODEL=anthropic/claude-haiku-4.5
# JUDGE_MODEL=
